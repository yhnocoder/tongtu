{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yhnocoder.github.io/tongtu/schemas/brief.schema.json",
  "title": "brief.json",
  "description": "全文纲要（survey 阶段一次通读产出，架构 §3/§7）：原文 abstract **照录**（不生成，避免全部块对摘要译文形成级联依赖）+ 章节结构树与每节摘要 + 记号与命名约定 + 文风基调。首要用途是逐块翻译的全局上下文（块间一致性靠稳定共享上下文，不靠链式传递译文）；随包分发后 read path 的 AI 摘要与会话预热可直接复用。字段粒度 M3 用三篇 fixture 校准。",
  "type": "object",
  "required": ["contract_version", "abstract", "sections"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "$ref": "#/$defs/contract_version" },
    "paper": {
      "type": "object",
      "description": "论文标识信息，全部照录原文。",
      "additionalProperties": false,
      "properties": {
        "arxiv_id": { "type": "string" },
        "title": { "type": "string", "description": "原文标题（照录）。" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "primary_category": { "type": "string", "description": "如 cs.CL。" }
      }
    },
    "abstract": {
      "type": "string",
      "description": "**原文** abstract 照录，不翻译不改写。"
    },
    "sections": {
      "type": "array",
      "description": "章节结构树（递归），每节带摘要。",
      "items": { "$ref": "#/$defs/section" }
    },
    "notation": {
      "type": "array",
      "description": "记号约定：全文出现的数学符号及其含义（主要来自行间公式——这正是 survey 通读视图回填数学类块的理由）。",
      "items": {
        "type": "object",
        "required": ["symbol", "meaning"],
        "additionalProperties": false,
        "properties": {
          "symbol": { "type": "string", "description": "LaTeX 形式的符号，如 \\mathcal{L}。" },
          "meaning": { "type": "string", "description": "中文说明。" },
          "first_seen": { "type": "string", "description": "首次出现的章节号或块 id。" }
        }
      }
    },
    "naming_conventions": {
      "type": "array",
      "description": "命名约定：模型名 / 方法名 / 数据集等专名在全文中的统一指称方式（词级硬约束在 glossary.json，此处记的是指称习惯）。",
      "items": {
        "type": "object",
        "required": ["name", "convention"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "convention": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "style": {
      "type": "object",
      "description": "文风基调：本篇特有的语体判断，与 glossary 的全局文风约定叠加。",
      "additionalProperties": false,
      "properties": {
        "tone": { "type": "string", "description": "如「严谨学术、少量口语化比喻」。" },
        "audience": { "type": "string", "description": "预期读者。" },
        "notes": { "type": "array", "items": { "type": "string" }, "description": "逐条文风提示。" }
      }
    },
    "generated_by": {
      "type": "object",
      "description": "产生此纲要的关节④调用信息，参与缓存判定。",
      "additionalProperties": false,
      "properties": {
        "model_id": { "type": "string" },
        "prompt_version": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "input_hash": {
          "$ref": "#/$defs/sha256",
          "description": "通读输入（masked.tex 选择性回填视图，已剔除附录与参考文献）的 hash。"
        }
      }
    }
  },
  "$defs": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "产物契约版本号（当前草案 0.1）。"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "小写十六进制 SHA-256。"
    },
    "section": {
      "type": "object",
      "required": ["title", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "章节 id 或 \\label 值。" },
        "number": { "type": "string", "description": "章节号，如 3.2。" },
        "title": { "type": "string", "description": "**原文**章节标题。" },
        "level": { "type": "integer", "minimum": 1, "description": "1 = section，2 = subsection，依此类推。" },
        "summary": { "type": "string", "description": "该节中文摘要（逐块翻译时作为全局上下文注入）。" },
        "is_appendix": { "type": "boolean", "description": "附录不进通读输入，但仍正常翻译。" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" },
          "description": "子节，递归。"
        }
      }
    }
  }
}
