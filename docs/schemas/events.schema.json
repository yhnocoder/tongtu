{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yhnocoder.github.io/tongtu/schemas/events.schema.json",
  "title": "events (--json 事件流)",
  "description": "`--json` 机器可读事件流（架构 §6，开放问题 3：一期容器调度前冻结，零期先出草案）。传输形式为 JSON Lines——stdout 每行一个独立事件对象，本 schema 校验的是**单个事件**，不是整个流。三类事件：阶段起止（stage_start / stage_end）、块进度（chunk_progress）、最终结果（result）。每行自带 contract_version，消费方无需缓存首行即可解析。",
  "type": "object",
  "required": ["contract_version", "event", "ts"],
  "oneOf": [
    { "$ref": "#/$defs/stage_start" },
    { "$ref": "#/$defs/stage_end" },
    { "$ref": "#/$defs/chunk_progress" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "产物契约版本号（当前草案 0.2）。每个事件都携带。"
    },
    "stage_start": {
      "type": "object",
      "description": "阶段开始。",
      "required": ["contract_version", "event", "ts", "stage"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/contract_version" },
        "event": { "const": "stage_start" },
        "ts": { "type": "string", "format": "date-time" },
        "run_id": { "type": "string" },
        "arxiv_id": { "type": "string" },
        "stage": { "type": "string", "description": "阶段名，见 tongtu.stages.STAGES。" },
        "total": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "该阶段的工作单元总数（translate 阶段为块数），未知则 null。"
        }
      }
    },
    "stage_end": {
      "type": "object",
      "description": "阶段结束。status = cached 表示按 manifest 判定输入未变、整段跳过。",
      "required": ["contract_version", "event", "ts", "stage", "status"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/contract_version" },
        "event": { "const": "stage_end" },
        "ts": { "type": "string", "format": "date-time" },
        "run_id": { "type": "string" },
        "arxiv_id": { "type": "string" },
        "stage": { "type": "string" },
        "status": { "enum": ["ok", "cached", "skipped", "failed"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "error": { "type": ["string", "null"], "description": "status 为 failed 时的一句话原因。" }
      }
    },
    "chunk_progress": {
      "type": "object",
      "description": "块进度（translate 阶段逐块发出，也用于 figures 的逐图进度）。",
      "required": ["contract_version", "event", "ts", "stage", "id", "status"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/contract_version" },
        "event": { "const": "chunk_progress" },
        "ts": { "type": "string", "format": "date-time" },
        "run_id": { "type": "string" },
        "arxiv_id": { "type": "string" },
        "stage": { "type": "string", "description": "通常为 translate。" },
        "id": { "type": "string", "description": "块 id（如 c012）或图 id。" },
        "index": { "type": "integer", "minimum": 0, "description": "0-based 序号。" },
        "total": { "type": "integer", "minimum": 0 },
        "status": {
          "enum": ["started", "cached", "translated", "retry", "fallback", "failed"],
          "description": "块级状态迁移。retry 表示 validate 失败后的内环重试。"
        },
        "attempt": { "type": "integer", "minimum": 1, "description": "第几次尝试。" },
        "reason": { "type": ["string", "null"], "description": "retry / fallback 的原因。" }
      }
    },
    "result": {
      "type": "object",
      "description": "最终结果，每次运行恰好一条，流的最后一行。",
      "required": ["contract_version", "event", "ts", "status", "exit_code"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/contract_version" },
        "event": { "const": "result" },
        "ts": { "type": "string", "format": "date-time" },
        "run_id": { "type": "string" },
        "arxiv_id": { "type": "string" },
        "status": {
          "enum": ["ok", "ok_with_fallback", "failed"],
          "description": "与 report.json 的 status 一致。"
        },
        "exit_code": {
          "type": "integer",
          "description": "进程退出码：0 = 产物包完整产出（含有回退块的情形）；非 0 = 未能出包。"
        },
        "out_dir": { "type": "string", "description": "产物包目录绝对路径。" },
        "pdf": { "type": ["string", "null"], "description": "zh.pdf 路径，未产出则 null。" },
        "report": { "type": ["string", "null"], "description": "report.json 路径。" },
        "chunks_total": { "type": "integer", "minimum": 0 },
        "fallback_chunks": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "error": { "type": ["string", "null"] }
      }
    }
  }
}
