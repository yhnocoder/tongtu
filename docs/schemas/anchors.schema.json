{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yhnocoder.github.io/tongtu/schemas/anchors.schema.json",
  "title": "anchors.json",
  "description": "交互地图（export 阶段合成，架构 §7）：公式 / 图 / 表 / 章节在 zh.pdf 中的页码与矩形区域，供静态检验页画热区与文枢 read path 定位。三来源（synctex / blocks 源码位置 / PDF 文本扫描）叠加，逐条记 source 与置信度。草案级，热区容差与叠加次序 M4 拿真实论文实测后校准。",
  "type": "object",
  "required": ["contract_version", "pdf", "coordinate_system", "anchors"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "$ref": "#/$defs/contract_version" },
    "pdf": {
      "type": "object",
      "description": "被标注的 PDF。",
      "required": ["path", "page_count"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "description": "产物包内相对路径，通常为 zh.pdf。" },
        "page_count": { "type": "integer", "minimum": 1 },
        "pages": {
          "type": "array",
          "description": "逐页尺寸（pt），前端换算缩放比例用。",
          "items": {
            "type": "object",
            "required": ["page", "width", "height"],
            "additionalProperties": false,
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "coordinate_system": {
      "type": "object",
      "description": "矩形坐标约定，避免前端猜。",
      "required": ["origin", "unit"],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": ["top-left", "bottom-left"],
          "description": "原点位置；默认 top-left（与 PDF.js 视口一致）。"
        },
        "unit": {
          "enum": ["pt"],
          "description": "长度单位，恒为 PDF 点（1/72 inch）。"
        }
      }
    },
    "anchors": {
      "type": "array",
      "description": "锚点列表，按页码与纵坐标排序。",
      "items": { "$ref": "#/$defs/anchor" }
    }
  },
  "$defs": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "产物契约版本号（当前草案 0.2）。"
    },
    "rect": {
      "type": "object",
      "description": "页内矩形（含容差外扩后的最终热区）。",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "minimum": 0 }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["id", "type", "page", "rects"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "锚点唯一 id。" },
        "type": {
          "enum": ["section", "equation", "figure", "table", "algorithm", "block", "citation"],
          "description": "锚点类型，决定检验页热区样式与点击行为。"
        },
        "label": {
          "type": ["string", "null"],
          "description": "LaTeX \\label 值（如 eq:loss），交叉引用键。"
        },
        "number": {
          "type": ["string", "null"],
          "description": "排版后的编号（如 3.2、Figure 4），从 PDF 或 aux 提取。"
        },
        "title": {
          "type": ["string", "null"],
          "description": "章节标题或 caption 首句，侧栏展示用。"
        },
        "block_id": {
          "type": ["string", "null"],
          "description": "对应 blocks.json 的块 id；点击热区即取其原始 TeX。"
        },
        "chunk_id": {
          "type": ["string", "null"],
          "description": "所属翻译块 id，用于「这段是回退原文」的标注。"
        },
        "page": { "type": "integer", "minimum": 1, "description": "1-based 页码。" },
        "rects": {
          "type": "array",
          "minItems": 1,
          "description": "热区矩形，跨行/跨栏对象可有多个。",
          "items": { "$ref": "#/$defs/rect" }
        },
        "source": {
          "enum": ["synctex", "blocks", "pdf-scan", "merged"],
          "description": "该锚点的定位来源；merged 表示多来源叠加。"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "定位置信度，供检验页区分实线/虚线热区。"
        }
      }
    }
  }
}
