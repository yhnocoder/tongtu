{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yhnocoder.github.io/tongtu/schemas/glossary.schema.json",
  "title": "glossary.json",
  "description": "术语表（架构 §8）。同一 schema 描述两种角色：用户可编辑的**输入表**（全局 ~/.config/tongtu/glossary.json → 论文目录内 → --glossary，后者覆盖前者）与产物包内的**决策表**（本篇实际生效决策，含 agent 新决策；用户条目优先于 agent 决策）。结构三段：不译清单 / 术语唯一译法 / 文风约定（style_version 所在）。术语条目按块内命中参与缓存 key，style_version 单列——bump 即全量重翻。",
  "type": "object",
  "required": ["contract_version", "style"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "$ref": "#/$defs/contract_version" },
    "do_not_translate": {
      "type": "array",
      "description": "第一段：不译清单。命中即原样保留（模型名、库名、专有缩写等）。",
      "items": {
        "type": "object",
        "required": ["term"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string", "description": "原文词形。" },
          "match": {
            "enum": ["exact", "case-insensitive", "word"],
            "description": "匹配方式，默认 word（词边界匹配）。"
          },
          "note": { "type": "string", "description": "备注，如「是数据集名，不是普通名词」。" },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "terms": {
      "type": "array",
      "description": "第二段：术语唯一译法。一个原文词一个译法，全篇强制一致。",
      "items": {
        "type": "object",
        "required": ["term", "translation"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string", "description": "原文术语。" },
          "translation": { "type": "string", "description": "唯一中文译法。" },
          "aliases": {
            "type": "array",
            "items": { "type": "string" },
            "description": "同义写法（复数、连字符变体、缩写），一并命中。"
          },
          "keep_original": {
            "type": "boolean",
            "description": "首次出现时是否在译名后括注原文。"
          },
          "note": { "type": "string", "description": "决策依据或歧义提示。" },
          "source": { "$ref": "#/$defs/source" },
          "decided_at": { "type": "string", "format": "date-time", "description": "agent 决策时间（决策表用）。" }
        }
      }
    },
    "style": {
      "type": "object",
      "description": "第三段：文风约定。全局规则，改动即全量重翻，故单列版本号。",
      "required": ["style_version"],
      "additionalProperties": false,
      "properties": {
        "style_version": {
          "type": "string",
          "description": "文风规则版本号。参与每块缓存 key；bump 是显式的全量重翻操作。"
        },
        "tone": { "type": "string", "description": "整体语体，如「学术书面语，不用网络口语」。" },
        "translator_notes": {
          "type": "boolean",
          "description": "译者注开关。"
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "逐条文风规则（标点、数字与单位、被动句处理、专名首现处理等）。"
        }
      }
    },
    "merged_from": {
      "type": "array",
      "description": "决策表专用：三层合并的来源清单，按优先级从低到高。",
      "items": {
        "type": "object",
        "required": ["layer", "path"],
        "additionalProperties": false,
        "properties": {
          "layer": { "enum": ["global", "paper", "cli"], "description": "全局 XDG / 论文目录内 / --glossary。" },
          "path": { "type": "string" },
          "entries": { "type": "integer", "minimum": 0, "description": "该层贡献的条目数。" }
        }
      }
    }
  },
  "$defs": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "产物契约版本号（当前草案 0.1）。"
    },
    "source": {
      "enum": ["global", "paper", "cli", "agent"],
      "description": "条目来源。用户三层（global/paper/cli）优先于 agent 决策。"
    }
  }
}
