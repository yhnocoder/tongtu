{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yhnocoder.github.io/tongtu/schemas/blocks.schema.json",
  "title": "blocks.json",
  "description": "掩码块清单（mask 阶段产出，架构 §3.1/§7）：每个重环境的类型、label、原始 TeX 与源码位置，外加从块内抽出的可翻译 caption 槽位。unmask 按此文件回填；survey 的选择性回填视图由 category/survey_restore 字段驱动。草案级，字段随 M1 mask 迁移审计校准。",
  "type": "object",
  "required": ["contract_version", "source", "blocks"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "$ref": "#/$defs/contract_version"
    },
    "source": {
      "type": "object",
      "description": "掩码输入（flat.tex）的溯源信息。",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "相对工作目录的路径，通常为 build/flat.tex。"
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "输入文件内容 hash，往返自检与增量构建的依据。"
        },
        "chars": {
          "type": "integer",
          "minimum": 0,
          "description": "输入字符数，用于「多少内容进了 LLM」的统计。"
        }
      }
    },
    "blocks": {
      "type": "array",
      "description": "掩码块，按在源码中出现的顺序排列。",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "captions": {
      "type": "array",
      "description": "从块内抽出的可翻译文本槽位（caption / captionof / title / abstract）。",
      "items": {
        "$ref": "#/$defs/caption"
      }
    },
    "environments": {
      "type": "array",
      "description": "全文 \\begin{X} 环境名的完备枚举及其分类结论（架构 §3.1 第 2 层）。",
      "items": {
        "type": "object",
        "required": ["name", "classification"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "环境名，如 theorem、tabularx。"
          },
          "classification": {
            "enum": ["prose", "heavy"],
            "description": "散文（进翻译流）或重环境（整块掩码）。"
          },
          "decided_by": {
            "enum": ["table", "newtheorem", "agent", "default"],
            "description": "分类来源：分类表 / \\newtheorem 声明自动归类 / 关节③ agent 判断 / 保守默认。"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "该环境在全文中出现次数。"
          }
        }
      }
    },
    "roundtrip_ok": {
      "type": "boolean",
      "description": "运行时往返自检结果：unmask(mask(x)) == x。为 false 时流水线不得放行。"
    }
  },
  "$defs": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "产物契约版本号（当前草案 0.1）。契约变更须先改 schema 再 bump 此值。"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "小写十六进制 SHA-256。"
    },
    "span": {
      "type": "object",
      "description": "在掩码输入文件中的源码位置，字符偏移半开区间 [start, end)。",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "line_start": { "type": "integer", "minimum": 1, "description": "1-based 起始行号。" },
        "line_end": { "type": "integer", "minimum": 1, "description": "1-based 结束行号。" }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "placeholder", "category", "tex"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BLK-[0-9]+$",
          "description": "块 id，前导区恒为 BLK-0。"
        },
        "placeholder": {
          "type": "string",
          "description": "掩码流中的不透明占位符，形如 ⟦BLK-3⟧。validate 的占位符 multiset 比对以此为单位。"
        },
        "category": {
          "enum": [
            "preamble",
            "math",
            "table",
            "figure",
            "algorithm",
            "code",
            "tikz",
            "theorem",
            "other"
          ],
          "description": "块分类，驱动 unmask 的参数化回填与 survey 的选择性回填视图。"
        },
        "environment": {
          "type": "string",
          "description": "LaTeX 环境名（如 align*、tabularx）；前导区块无此字段。"
        },
        "label": {
          "type": ["string", "null"],
          "description": "块内 \\label{...} 的值，anchors 合成时的交叉引用键。"
        },
        "tex": {
          "type": "string",
          "description": "原始 TeX 全文（含 \\begin/\\end），caption 已替换为 ⟦CAP-k⟧ 槽位。回填即用此串。"
        },
        "span": { "$ref": "#/$defs/span" },
        "survey_restore": {
          "type": "boolean",
          "description": "survey 通读视图中是否回填原文（数学类为 true，表格/图/代码为 false）。"
        },
        "caption_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "本块内抽出的 caption 槽位 id。"
        }
      }
    },
    "caption": {
      "type": "object",
      "required": ["id", "placeholder", "text"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CAP-[0-9]+$",
          "description": "caption 槽位 id。"
        },
        "placeholder": {
          "type": "string",
          "description": "块内的槽位占位符，形如 ⟦CAP-2⟧。"
        },
        "block_id": {
          "type": "string",
          "description": "所属块 id。"
        },
        "kind": {
          "enum": ["caption", "captionof", "title", "abstract", "other"],
          "description": "槽位来源。"
        },
        "text": {
          "type": "string",
          "description": "槽位原文（进翻译流的可译文本）。"
        }
      }
    }
  }
}
