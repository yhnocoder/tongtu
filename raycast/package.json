{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tongtu",
  "title": "通途",
  "description": "把 arXiv 论文翻译成中文 PDF，查看翻译进度和结果",
  "icon": "icon.png",
  "author": "zach",
  "license": "MIT",
  "commands": [
    {
      "name": "translate",
      "title": "翻译论文",
      "description": "在后台运行 tongtu run，结束时发系统通知",
      "mode": "view",
      "arguments": [
        {
          "name": "paper",
          "placeholder": "arXiv 编号或链接（可不填）",
          "type": "text",
          "required": false
        },
        {
          "name": "mode",
          "placeholder": "模式",
          "type": "dropdown",
          "required": false,
          "data": [
            {
              "title": "默认",
              "value": ""
            },
            {
              "title": "fast",
              "value": "fast"
            },
            {
              "title": "smart",
              "value": "smart"
            }
          ]
        }
      ]
    },
    {
      "name": "papers",
      "title": "论文",
      "description": "列出全部论文的状态，打开译文，重试或停止翻译",
      "mode": "view"
    },
    {
      "name": "settings",
      "title": "设置",
      "description": "修改 config.toml 里的模式、字体和 PDF 选项",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "latest"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.0.10",
    "typescript": "^5"
  },
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist -o dist",
    "lint": "ray lint",
    "test": "node --test test/"
  }
}
