{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR\"/scripts/diction_lint.py --hook",
            "timeout": 30,
            "statusMessage": "措辞与命名检查"
          }
        ]
      }
    ]
  }
}
